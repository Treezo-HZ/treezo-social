@keyframes rt-fade-in {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes rt-fade-out {=20
  0% { opacity: 1; }
  100% { opacity: 0; }
}

@keyframes rt-slide-from-top {=20
  0% { transform: translateY(4px) scale(0.97); }
  100% { transform: translateY(0px) scale(1); }
}

@keyframes rt-slide-to-top {=20
  0% { transform: translateY(0px) scale(1); }
  100% { transform: translateY(4px) scale(0.97); }
}

@keyframes rt-slide-from-bottom {=20
  0% { transform: translateY(-4px) scale(0.97); }
  100% { transform: translateY(0px) scale(1); }
}

@keyframes rt-slide-to-bottom {=20
  0% { transform: translateY(0px) scale(1); }
  100% { transform: translateY(-4px) scale(0.97); }
}

@keyframes rt-slide-from-left {=20
  0% { transform: translate(4px) scale(0.97); }
  100% { transform: translate(0px) scale(1); }
}

@keyframes rt-slide-to-left {=20
  0% { transform: translate(0px) scale(1); }
  100% { transform: translate(4px) scale(0.97); }
}

@keyframes rt-slide-from-right {=20
